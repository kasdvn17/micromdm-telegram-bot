# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Username Telegram được uỷ quyền dùng lệnh Normal, KHÔNG kèm dấu "@"
AUTHORIZED_TELEGRAM_USERNAME=
# Khuyên dùng: numeric user ID ổn định hơn username (xem bằng /whoami)
AUTHORIZED_TELEGRAM_USER_ID=
# Chat ID Telegram của bạn (dùng để bot tự động gửi thông báo)
AUTHORIZED_TELEGRAM_CHAT_ID=

# --- Codeforces ---
# Handle dùng cho /task, /refresh; gate 1 task/break, 7 task/ngày hoặc 3 task/Sleep để Focus off
CODEFORCES_HANDLE=

# --- Emergency ---
# Mật khẩu dùng cho nhóm lệnh Emergency và làm 1 trong 2 lớp xác thực của /api
# Lưu ý: theo yêu cầu, được lưu plaintext (secret cá nhân) - KHÔNG commit file .env thật lên git
EMERGENCY_PASSWORD=

# --- MicroMDM ---
MICROMDM_URL=https://your-micromdm-server.example.com
MICROMDM_API_KEY=
WEBHOOK_PORT=6364
WEBHOOK_PATH=/webhook/micromdm
COMMAND_RESULT_TIMEOUT_MS=30000

# --- Device ---
DEVICE_UUID=

# --- Polling intervals (ms) - có thể để trống để dùng default trong constants.ts ---
DEVICE_INFO_POLL_INTERVAL_MS=
MARK_LOST_POLL_INTERVAL_MS=
# Mặc định 3600000ms (1 giờ), mỗi interval gửi đúng 1 câu danh ngôn
QUOTE_INTERVAL_MS=3600000

# --- Paths (có thể để trống để dùng default ./data/*) ---
LOG_DIR=
HISTORY_FILE_PATH=
CODEFORCES_TASKS_FILE_PATH=
SCHEDULE_FILE_PATH=
BLACKLIST_FILE_PATH=
RESTRICTED_APPS_FILE_PATH=
CHECKIN_STATE_FILE_PATH=
SENSITIVE_APPS_FILE_PATH=
FOCUS_WEBSITES_FILE_PATH=
BLACKLIST_WEBSITES_FILE_PATH=
DEFAULT_PROFILE_PLIST_PATH=
# IANA timezone dùng cho Focus/Sleep và gate theo ngày.
BOT_TIMEZONE=Asia/Ho_Chi_Minh

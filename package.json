{
  "name": "micromdm-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot controlling a single supervised iPhone via the MicroMDM REST API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "bun run --watch src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-fetch": "^2.7.0",
    "node-telegram-bot-api": "^0.66.0",
    "plist": "^3.1.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "discord.js-selfbot-v13": "3.7.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "@types/node": "^20.14.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/node-fetch": "^2.6.11",
    "@types/plist": "^3.0.5"
  }
}
